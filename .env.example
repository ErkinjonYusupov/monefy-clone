# ============================================================
#  Lokal ishlab chiqish uchun: `cp .env.example .env`
#  Prod (Dokploy) uchun pastdagi izohlarga qarang.
# ============================================================

# --- Server ---
# HTTP port. Lokalda 8090 (8080 band bo'lsa).
# Dokploy'da QO'YMANG: Docker image'da 8080 avtomatik.
PORT=8090

# --- Ma'lumotlar bazasi ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# Baza (DBNAME) mavjud bo'lmasa, server uni o'zi yaratadi.
# Dokploy'da HOST = Postgres servisining "Internal Host" qiymati (localhost emas!).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monefy?sslmode=disable

# --- Telegram ---
# @BotFather dan olingan token (majburiy)
BOT_TOKEN=
# Adminning shaxsiy Telegram ID'si (botga yozgan chat ID'si bilan bir xil):
# - shu foydalanuvchiga Mini App menyusida "Admin panel" ko'rinadi
# - bot admin buyruqlari shu chatda ishlaydi, yangi foydalanuvchi va premium so'rovlari shu yerga keladi
ADMIN_CHAT_ID=
# Mini App manzili (HTTPS), /start dagi "Ilovani ochish" tugmasi uchun
WEBAPP_URL=
# Bot xabarlarni qabul qiladimi. Bitta token bilan faqat bitta nusxada true bo'lsin
# (prod'da true, lokalda shu token ishlatilsa false).
BOT_POLLING=true

# --- Faqat lokal ---
# Vite dev server manzili (prod'da kerak emas: sayt va API bitta domenda)
CORS_ORIGINS=http://localhost:5173
# Telegram'siz brauzerda test: shu telegram_id bilan kiriladi.
# Prod'da QO'YMANG, aks holda har kim shu foydalanuvchi sifatida kiradi!
DEV_TELEGRAM_ID=
