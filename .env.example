PORT=8090
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monefy?sslmode=disable
BOT_TOKEN=
# Admin buyruqlari faqat shu chatda ishlaydi, yangi foydalanuvchi va premium so'rovlari shu yerga keladi
ADMIN_CHAT_ID=
# Mini App manzili (HTTPS), /start tugmasi uchun
WEBAPP_URL=
CORS_ORIGINS=http://localhost:5173
# Faqat lokal test: initData bo'lmasa shu telegram_id bilan kiriladi. Prod'da bo'sh qoldiring!
DEV_TELEGRAM_ID=
# Bitta tokenda bir nechta nusxa ishlasa, faqat bittasida polling yoqing
BOT_POLLING=true
# Docker image'da avtomatik: React build shu papkadan beriladi
STATIC_DIR=
